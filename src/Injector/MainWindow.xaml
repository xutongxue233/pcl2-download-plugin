<Window x:Class="PCL.DownloadRestore.Injector.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PCL下载恢复工具" Width="700" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanMinimize"
        AllowsTransparency="True" Background="Transparent"
        FontFamily="{StaticResource PclFont}"
        FontSize="13" Foreground="{DynamicResource ColorBrush1}"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="Grayscale"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Closing="WindowClosing" Closed="WindowClosed" Activated="WindowActivated">
    <!-- FormMain.xaml: 48-DIP header, 6-DIP window corners, original window controls. -->
    <Grid Margin="18">
        <Border CornerRadius="6" Background="White" IsHitTestVisible="False">
            <Border.Effect><DropShadowEffect Color="#343D4A" BlurRadius="9" ShadowDepth="1" Opacity="0.18" /></Border.Effect>
        </Border>
        <Border x:Name="Frame" CornerRadius="6" Background="{StaticResource PclPageBackground}" SizeChanged="FrameSizeChanged">
            <Border.Clip><RectangleGeometry x:Name="FrameClip" RadiusX="6" RadiusY="6" /></Border.Clip>
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="48" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid Background="{StaticResource PclTitleBackground}" MouseLeftButtonDown="DragTitle">
                    <TextBlock Text="PCL下载恢复工具" Foreground="White" FontSize="16"
                               HorizontalAlignment="Left" VerticalAlignment="Center" Margin="20,0,90,0"
                               IsHitTestVisible="False" />
                    <Button Style="{StaticResource PclTitleButton}" HorizontalAlignment="Right" Height="28" Width="28" Margin="0,0,44,0" VerticalAlignment="Center" Click="MinimizeClick" AutomationProperties.Name="最小化">
                        <Path Data="F1 M0,0 h15 v2 h-15 v-2 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="11" Stretch="Uniform" />
                    </Button>
                    <Button Style="{StaticResource PclTitleButton}" HorizontalAlignment="Right" Height="28" Width="28" Margin="0,0,12,0" VerticalAlignment="Center" Click="CloseClick" AutomationProperties.Name="关闭">
                        <Path Data="F1 M2,0 L0,2 8,10 0,18 2,20 10,12 18,20 20,18 12,10 20,2 18,0 10,8 2,0Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="12" Height="12" Stretch="Uniform" />
                    </Button>
                </Grid>
                <StackPanel Grid.Row="1" Margin="25,20,25,16">
                    <Grid>
                        <Border Style="{StaticResource PclCardShadow}" />
                        <Border Style="{StaticResource PclCard}" Background="Transparent" Padding="15,12,15,18">
                            <StackPanel>
                                <TextBlock Text="选择 PCL 程序" FontWeight="Bold" />
                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBox x:Name="LauncherPath" Style="{StaticResource PclTextBox}" Height="30" Margin="0,0,12,0"
                                             Tag="选择或拖入 PCL.exe" TextChanged="PathChanged" AllowDrop="True"
                                             PreviewDragOver="PathDragOver" Drop="PathDrop" AutomationProperties.Name="PCL 程序路径" />
                                    <Button x:Name="BrowseButton" Grid.Column="1" Content="选择文件" Style="{StaticResource PclButton}" Width="90" Height="30" Click="BrowseClick" />
                                </Grid>
                                <StackPanel Margin="0,16,0,0" MinHeight="43">
                                    <TextBlock x:Name="StatusTitle" Text="请选择官方 PCL 2.99.0.0" />
                                    <TextBlock x:Name="StatusMessage" Text="安装一次，之后启动 PCL 自动生效。" Foreground="{DynamicResource ColorBrushGray3}" FontSize="12" Margin="0,5,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,17,0,0">
                                    <Button x:Name="InstallButton" Content="注入插件" Style="{StaticResource PclPrimaryButton}" Width="120" Height="35" Margin="0,0,12,0" IsEnabled="False" Click="InstallClick" />
                                    <Button x:Name="UninstallButton" Content="卸载插件" Style="{StaticResource PclButton}" Width="120" Height="35" IsEnabled="False" Click="UninstallClick" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Grid Margin="0,13,0,0">
                        <TextBlock Text="适用于 PCL 2.99.0.0 · 第三方插件" FontSize="12" Foreground="{DynamicResource ColorBrushGray3}" VerticalAlignment="Center" />
                        <Button x:Name="LogsButton" Content="查看日志" HorizontalAlignment="Right" Style="{StaticResource PclLinkButton}" Click="LogsClick" />
                    </Grid>
                    <Grid x:Name="LogsPanel" Visibility="Collapsed" Margin="0,12,0,0">
                        <Border Style="{StaticResource PclCardShadow}" />
                        <Border Style="{StaticResource PclCard}" Background="Transparent" Padding="15">
                            <TextBox x:Name="LogsText" IsReadOnly="True" BorderThickness="0" Background="Transparent" Height="185" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" FontFamily="Consolas, Microsoft YaHei UI" FontSize="12" AutomationProperties.Name="操作与插件启动日志" />
                        </Border>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
