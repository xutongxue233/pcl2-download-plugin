<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <AssemblyName>PCL.DownloadRestore.Injector</AssemblyName>
    <RootNamespace>PCL.DownloadRestore.Injector</RootNamespace>
    <Version>1.1.4</Version>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <Prefer32Bit>false</Prefer32Bit>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Description>Third-party application-local PCL plugin injector with runtime interface compatibility checks.</Description>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Runtime.Serialization" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <!-- 仅用于构建的依赖：载荷仍内嵌在单个注入器 EXE 中。 -->
    <ProjectReference Include="..\Bootstrap\PCL.PluginBootstrap.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\DownloadRestore\PCL.DownloadRestore.csproj" ReferenceOutputAssembly="false" Private="false" />
    <EmbeddedResource Include="..\Bootstrap\bin\$(Configuration)\net48\PCL.PluginBootstrap.dll" LogicalName="payload.PCL.PluginBootstrap.dll" />
    <EmbeddedResource Include="..\DownloadRestore\bin\$(Configuration)\net48\PCL.DownloadRestore.dll" LogicalName="payload.PCL.DownloadRestore.dll" />
    <EmbeddedResource Include="..\DownloadRestore\bin\$(Configuration)\net48\0Harmony.dll" LogicalName="payload.0Harmony.dll" />
  </ItemGroup>
</Project>
